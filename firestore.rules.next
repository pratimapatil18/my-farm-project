rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function publicCatalogReady() {
      return exists(/databases/$(database)/documents/system/publicCatalog)
        && get(/databases/$(database)/documents/system/publicCatalog).data.ready == true;
    }

    // Admin data is accessed only through callable Functions, which recheck the
    // current Auth user record. Firestore rules cannot notice a revoked custom
    // claim until a cached ID token refreshes, so block all direct client access.
    match /products/{productId} {
      allow read, write: if false;
    }

    match /catalog/{productId} {
      // The migration gates list access until every document is sanitized.
      // Rules cannot redact fields from query results; trusted writers therefore
      // replace this document with the known public projection on every change.
      allow get, list: if publicCatalogReady()
        && resource.data.active == true
        && resource.data.keys().hasOnly([
          'name', 'category', 'price', 'unit', 'emoji', 'image', 'imageAlt',
          'imageSource', 'color', 'badge', 'active', 'inStock',
          'seasonalAvailability', 'updatedAt'
        ]);
      allow create, update, delete: if false;
    }

    // Customer contact and address data is private. Admin UI reads orders via
    // privileged callable functions; direct client writes are never allowed.
    match /orders/{orderId} {
      allow read, write: if false;
    }

    // Default-deny everything else, including customer profile collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
