{
  "name": "pratimas-farm-functions",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "emulate": "FIREBASE_DEBUG_MODE=true FIREBASE_DEBUG_FEATURES='{\"skipTokenVerification\":true}' XDG_CONFIG_HOME=../.firebase-cli-config firebase emulators:start --config ../firebase.local.json --only auth,firestore,functions",
    "test:rules": "XDG_CONFIG_HOME=../.firebase-cli-config firebase emulators:exec --config ../firebase.local.json --only firestore \"node --test test/firestore.rules.test.mjs\"",
    "test:emulator": "FIREBASE_DEBUG_MODE=true FIREBASE_DEBUG_FEATURES='{\"skipTokenVerification\":true}' XDG_CONFIG_HOME=../.firebase-cli-config firebase emulators:exec --config ../firebase.local.json --only auth,firestore,functions \"node --test --test-concurrency=1 test/firestore.rules.test.mjs test/admin.integration.test.mjs test/admin-csv.test.mjs test/safety-scripts.test.mjs test/app-check-client.test.mjs\"",
    "seed:catalog": "node scripts/seed-catalog.cjs --emulator",
    "admin:grant": "node scripts/admin-claim.cjs grant --emulator",
    "admin:revoke": "node scripts/admin-claim.cjs revoke --emulator"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.33.0"
  }
}
