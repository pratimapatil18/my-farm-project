{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "ignore": [
      ".git",
      ".runtimeconfig.json",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "firestore-debug.log",
      "node_modules",
      "my-farm-project/**",
      "**/.git/**"
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.local.json",
      "README.md",
      "IMAGE_SOURCES.md",
      "firestore.rules.next",
      "firestore.rules",
      "firestore.indexes.json",
      "ADMIN_SECURITY_PLAN.md",
      "firebase-check.html",
      "tests/**",
      "functions/**",
      "**/.*",
      ".git/**",
      "**/.git/**",
      ".firebase-cli-config/**",
      "**/.firebase-cli-config/**",
      ".firebase/**",
      "**/.firebase/**",
      "**/node_modules/**",
      "**/*.zip",
      "**/*.log"
    ]
  }
}
